generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  GIFTED
  REFUNDED_UNAVAILABLE
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GiftStatus {
  AWAITING_REDEMPTION
  REDEEMED
  FULFILLED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  FAILED
  RETURNED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum AuraLedgerType {
  INVITE_ACCEPTED
  GIFT_PAID
  MILESTONE
  REFUND_REVERSAL
  ADMIN_ADJUSTMENT
}

enum CosmeticKind {
  FRAME
  EFFECT
  THEME
  BADGE
}

enum CosmeticPurchaseStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  REFUNDED
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  phone            String?   @unique
  emailVerifiedAt  DateTime? @map("email_verified_at")
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  passwordHash     String?   @map("password_hash")
  displayName      String?   @map("display_name")
  role             Role      @default(CUSTOMER)
  telegramId       String?   @unique @map("telegram_id")
  telegramUsername String?   @map("telegram_username")
  botCanMessage    Boolean   @default(false) @map("bot_can_message")
  earnedAura       Int       @default(0) @map("earned_aura")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions           Session[]
  auditLogs          AuditLog[]
  creator            CreatorProfile?
  orders             Order[]              @relation("BuyerOrders")
  giftsReceived      Gift[]               @relation("GiftRecipient")
  giftsBought        Gift[]               @relation("GiftBuyer")
  addresses          Address[]
  auraLedger         AuraLedgerEntry[]
  inviteClaims       CreatorInviteClaim[] @relation("FanInviteClaims")
  milestones         UserMilestone[]
  cosmetics          UserCosmetic[]
  cosmeticLoadout    UserCosmeticLoadout?
  cosmeticPurchases  CosmeticPurchase[]
  streaks            CreatorStreak[]    @relation("FanStreaks")
  streakPurchases    StreakPurchase[]

  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String    @unique @map("refresh_hash")
  familyId     String    @map("family_id")
  replacedById String?   @map("replaced_by_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  purpose     String
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  contextKey  String?   @map("context_key")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

model ActionToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("action_tokens")
}

model CreatorProfile {
  id                String        @id @default(cuid())
  userId            String        @unique @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String        @unique
  shortCode         String        @unique @map("short_code")
  displayName       String        @map("display_name")
  bio               String        @default("")
  avatarUrl         String?       @map("avatar_url")
  giftNote          String        @default("") @map("gift_note")
  personaDisclosure String?       @map("persona_disclosure")
  status            CreatorStatus @default(PENDING)
  approvedAt        DateTime?     @map("approved_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  wishlist        WishlistItem[]
  orders          Order[]
  inviteClaims    CreatorInviteClaim[]
  streaks         CreatorStreak[]
  streakPurchases StreakPurchase[]

  @@map("creator_profiles")
}

model WishlistItem {
  id        String         @id @default(cuid())
  creatorId String         @map("creator_id")
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  sortOrder Int            @default(0) @map("sort_order")
  isVisible Boolean        @default(true) @map("is_visible")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([creatorId, variantId])
  @@index([creatorId, sortOrder])
  @@map("wishlist_items")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Occasion {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("occasions")
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  story        String?
  status       ProductStatus @default(DRAFT)
  type         ProductType   @default(PHYSICAL)
  shippingPaise Int          @default(0) @map("shipping_paise")
  deliveryInfo String?       @map("delivery_info")
  refundTerms  String?       @map("refund_terms")
  categoryId   String?       @map("category_id")
  category     Category?     @relation(fields: [categoryId], references: [id])
  occasionId   String?       @map("occasion_id")
  occasion     Occasion?     @relation(fields: [occasionId], references: [id])
  giftedCount  Int           @default(0) @map("gifted_count")
  images       ProductImage[]
  variants     ProductVariant[]
  digitalAsset DigitalAsset?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, categoryId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId, sortOrder])
  @@map("product_images")
}

model DigitalAsset {
  id          String   @id @default(cuid())
  productId   String   @unique @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String   @map("storage_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @default(0) @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("digital_assets")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String
  pricePaise     Int      @map("price_paise")
  compareAtPaise Int?     @map("compare_at_paise")
  onHand         Int      @default(0) @map("on_hand")
  reserved       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  reservations InventoryReservation[]
  adjustments  StockAdjustment[]
  wishlist     WishlistItem[]

  @@map("product_variants")
}

model InventoryReservation {
  id          String            @id @default(cuid())
  orderItemId String            @unique @map("order_item_id")
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variantId   String            @map("variant_id")
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([status])
  @@map("inventory_reservations")
}

model StockAdjustment {
  id        String         @id @default(cuid())
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  delta     Int
  onHand    Int            @map("on_hand")
  reserved  Int
  reason    String
  actorId   String?        @map("actor_id")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("stock_adjustments")
}

model Order {
  id               String      @id @default(cuid())
  publicRef        String      @unique @map("public_ref")
  buyerId          String      @map("buyer_id")
  buyer            User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  creatorId        String      @map("creator_id")
  creator          CreatorProfile @relation(fields: [creatorId], references: [id])
  message          String      @default("")
  contactPhone     String?     @map("contact_phone")
  status           OrderStatus @default(PENDING_PAYMENT)
  currency         String      @default("INR")
  subtotalPaise    Int         @map("subtotal_paise")
  shippingPaise    Int         @map("shipping_paise")
  totalPaise       Int         @map("total_paise")
  paymentExpiresAt DateTime    @map("payment_expires_at")
  checkoutAttempt  Int         @default(0) @map("checkout_attempt")
  channel          String      @default("web")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]

  @@index([buyerId, createdAt])
  @@index([creatorId, createdAt])
  @@index([status, paymentExpiresAt])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String          @map("order_id")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String          @map("variant_id")
  productName    String          @map("product_name")
  variantName    String          @map("variant_name")
  imageUrl       String?         @map("image_url")
  productType    ProductType     @map("product_type")
  quantity       Int
  unitPricePaise Int             @map("unit_price_paise")
  shippingPaise  Int             @map("shipping_paise")
  lineTotalPaise Int             @map("line_total_paise")
  status         OrderItemStatus @default(PENDING)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  reservation InventoryReservation?
  gift        Gift?
  refunds     Refund[]

  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("CASHFREE")
  providerOrderId   String        @unique @map("provider_order_id")
  paymentSessionId  String?       @map("payment_session_id")
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(CREATED)
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  events  PaymentEvent[]
  refunds Refund[]

  @@index([status, updatedAt])
  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String?  @map("payment_id")
  payment         Payment? @relation(fields: [paymentId], references: [id])
  providerEventId String   @unique @map("provider_event_id")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("payment_events")
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String       @map("payment_id")
  payment          Payment      @relation(fields: [paymentId], references: [id])
  orderItemId      String?      @map("order_item_id")
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id])
  providerRefundId String?      @unique @map("provider_refund_id")
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(PENDING)
  reason           String
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("refunds")
}

model Gift {
  id          String     @id @default(cuid())
  orderItemId String     @unique @map("order_item_id")
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  recipientId String     @map("recipient_id")
  recipient   User       @relation("GiftRecipient", fields: [recipientId], references: [id])
  buyerId     String     @map("buyer_id")
  buyer       User       @relation("GiftBuyer", fields: [buyerId], references: [id])
  status      GiftStatus @default(AWAITING_REDEMPTION)
  openedAt    DateTime?  @map("opened_at")
  expiresAt   DateTime   @map("expires_at")
  remindedAt  DateTime?  @map("reminded_at")
  needsRefund Boolean    @default(false) @map("needs_refund")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  events       GiftEvent[]
  redemption   Redemption?
  shipment     Shipment?
  digitalAccess DigitalAccess?

  @@index([recipientId, createdAt])
  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
  @@map("gifts")
}

model GiftEvent {
  id         String   @id @default(cuid())
  giftId     String   @map("gift_id")
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([giftId, createdAt])
  @@map("gift_events")
}

model Address {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home")
  line1       String
  line2       String   @default("")
  city        String
  state       String
  postalCode  String   @map("postal_code")
  countryCode String   @default("IN") @map("country_code")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model Redemption {
  id         String   @id @default(cuid())
  giftId     String   @unique @map("gift_id")
  gift       Gift     @relation(fields: [giftId], references: [id])
  line1      String   @default("")
  line2      String   @default("")
  city       String   @default("")
  state      String   @default("")
  postalCode String   @default("") @map("postal_code")
  countryCode String  @default("IN") @map("country_code")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("redemptions")
}

model Shipment {
  id          String         @id @default(cuid())
  giftId      String         @unique @map("gift_id")
  gift        Gift           @relation(fields: [giftId], references: [id])
  status      ShipmentStatus @default(PENDING)
  carrier     String?
  trackingRef String?        @map("tracking_ref")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  events      ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id         String    @id @default(cuid())
  shipmentId String    @map("shipment_id")
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fromStatus String?   @map("from_status")
  toStatus   String    @map("to_status")
  note       String?
  actorId    String?   @map("actor_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

model DigitalAccess {
  id        String   @id @default(cuid())
  giftId    String   @unique @map("gift_id")
  gift      Gift     @relation(fields: [giftId], references: [id])
  grantedAt DateTime @default(now()) @map("granted_at")
  downloads DigitalDownload[]

  @@map("digital_access")
}

model DigitalDownload {
  id        String        @id @default(cuid())
  accessId  String        @map("access_id")
  access    DigitalAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("digital_downloads")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String
  scope        String
  route        String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([key, scope, route])
  @@map("idempotency_records")
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String
  to        String
  template  String
  status    String
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notification_logs")
}

model AuraLedgerEntry {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AuraLedgerType
  amount         Int
  idempotencyKey String         @unique @map("idempotency_key")
  creatorId      String?        @map("creator_id")
  orderItemId    String?        @map("order_item_id")
  refundId       String?        @map("refund_id")
  milestoneKey   String?        @map("milestone_key")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  milestone UserMilestone?

  @@index([userId, createdAt(sort: Desc)])
  @@map("aura_ledger_entries")
}

model CreatorInviteClaim {
  id         String         @id @default(cuid())
  fanId      String         @map("fan_id")
  fan        User           @relation("FanInviteClaims", fields: [fanId], references: [id], onDelete: Cascade)
  creatorId  String         @map("creator_id")
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  acceptedAt DateTime       @default(now()) @map("accepted_at")

  @@unique([fanId, creatorId])
  @@map("creator_invite_claims")
}

model UserMilestone {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneKey   String          @map("milestone_key")
  ledgerEntryId  String          @unique @map("ledger_entry_id")
  ledgerEntry    AuraLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  achievedAt     DateTime        @default(now()) @map("achieved_at")

  @@unique([userId, milestoneKey])
  @@map("user_milestones")
}

model CosmeticItem {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String       @default("")
  kind        CosmeticKind
  pricePaise  Int          @default(0) @map("price_paise")
  previewUrl  String?      @map("preview_url")
  cssClass    String?      @map("css_class")
  sortOrder   Int          @default(0) @map("sort_order")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owners    UserCosmetic[]
  purchases CosmeticPurchase[]

  @@map("cosmetic_items")
}

model UserCosmetic {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String       @map("item_id")
  item      CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source    String       @default("purchase")
  grantedAt DateTime     @default(now()) @map("granted_at")

  @@unique([userId, itemId])
  @@map("user_cosmetics")
}

model UserCosmeticLoadout {
  userId        String        @id @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  frameItemId   String?       @map("frame_item_id")
  effectItemId  String?       @map("effect_item_id")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("user_cosmetic_loadouts")
}

model CosmeticPurchase {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId            String                 @map("item_id")
  item              CosmeticItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  providerOrderId   String                 @unique @map("provider_order_id")
  paymentSessionId  String?                @map("payment_session_id")
  providerPaymentId String?                @map("provider_payment_id")
  amountPaise       Int                    @map("amount_paise")
  status            CosmeticPurchaseStatus @default(PENDING_PAYMENT)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("cosmetic_purchases")
}

enum StreakPurchaseStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

model CreatorStreak {
  id          String         @id @default(cuid())
  fanId       String         @map("fan_id")
  fan         User           @relation("FanStreaks", fields: [fanId], references: [id], onDelete: Cascade)
  creatorId   String         @map("creator_id")
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  days        Int            @default(0)
  lastPaidOn  String?        @map("last_paid_on")
  activeUntil DateTime?      @map("active_until")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([fanId, creatorId])
  @@map("creator_streaks")
}

model StreakPurchase {
  id                String               @id @default(cuid())
  fanId             String               @map("fan_id")
  fan               User                 @relation(fields: [fanId], references: [id], onDelete: Cascade)
  creatorId         String               @map("creator_id")
  creator           CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  providerOrderId   String               @unique @map("provider_order_id")
  paymentSessionId  String?              @map("payment_session_id")
  providerPaymentId String?              @map("provider_payment_id")
  amountPaise       Int                  @map("amount_paise")
  status            StreakPurchaseStatus @default(PENDING_PAYMENT)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([fanId, creatorId, createdAt(sort: Desc)])
  @@map("streak_purchases")
}
